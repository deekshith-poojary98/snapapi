{
  "name": "snapapi-language",
  "displayName": "SnapAPI",
  "description": "Language pack for SnapAPI .sapi files: highlighting, snippets, diagnostics, and run commands.",
  "version": "0.1.0",
  "publisher": "deekshithpoojary",
  "license": "MIT",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:snaptest",
    "onCommand:snapapi.runCurrentFile",
    "onCommand:snapapi.runTestAtCursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Deekshith-07/snapapi.git"
  },
  "bugs": {
    "url": "https://github.com/Deekshith-07/snapapi/issues"
  },
  "homepage": "https://github.com/Deekshith-07/snapapi#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "snapapi",
    "snaptest",
    "http",
    "api",
    "testing"
  ],
  "contributes": {
    "languages": [
      {
        "id": "snaptest",
        "aliases": [
          "SnapAPI",
          "SnapTest",
          "snaptest"
        ],
        "extensions": [
          ".sapi",
          ".snaptest"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "snaptest",
        "scopeName": "source.snaptest",
        "path": "./syntaxes/snaptest.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "snaptest",
        "path": "./snippets/snaptest.json"
      }
    ],
    "commands": [
      {
        "command": "snapapi.runCurrentFile",
        "title": "SnapAPI: Run current file",
        "icon": "$(play)"
      },
      {
        "command": "snapapi.runTestAtCursor",
        "title": "SnapAPI: Run test at cursor",
        "icon": "$(debug-line-by-line)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snapapi.runCurrentFile",
          "when": "resourceLangId == snaptest",
          "group": "navigation@1"
        },
        {
          "command": "snapapi.runTestAtCursor",
          "when": "resourceLangId == snaptest",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "snapapi.runCurrentFile",
          "when": "resourceLangId == snaptest",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SnapAPI",
      "properties": {
        "snapapi.cliPath": {
          "type": "string",
          "default": "snapapi",
          "markdownDescription": "Path to the SnapAPI CLI. Leave as `snapapi` to use `PATH`, then `${workspaceFolder}/.venv/bin/snapapi`. Set an explicit path if your venv lives elsewhere."
        },
        "snapapi.envFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional `KEY=VALUE` file passed as `--env` when running tests. Supports `${workspaceFolder}`."
        },
        "snapapi.profile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional environment profile passed as `--profile` (loads `environments/<name>.env`, `.snapapi/<name>.env`, or `<name>.env`)."
        }
      }
    }
  }
}
