{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "SnapTest",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#httpMethods"
        },
        {
            "include": "#assertionKeywords"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#urls"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.snaptest",
                    "match": "\\b(SUITE|DESC|URL|TEST|DATA|HEADERS|SETUP|TEARDOWN|TAG|REQUEST|EXPECT|OPTIONS|SAVE|IMPORT|FROM)\\b"
                }
            ]
        },
        "httpMethods": {
            "patterns": [
                {
                    "name": "keyword.other.httpmethod.snaptest",
                    "match": "\\b(GET|POST|DELETE|PUT|PATCH)\\b"
                }
            ]
        },
        "assertionKeywords": {
            "patterns": [
                {
                    "name": "keyword.other.assertion.snaptest",
                    "match": "\\b(STATUS|CONTAINS|JSON|HEADER|RETRY)\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.interpolated.snaptest",
                    "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.snaptest",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.snaptest",
                    "match": "\\\\."
                },
                {
                    "name": "variable.other.interpolated.snaptest",
                    "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
                }
            ]
        },
        "comments": {
            "name": "comment.line.double-slash.snaptest",
            "begin": "//",
            "end": "$"
        },
        "numbers": {
            "name": "constant.numeric.snaptest",
            "match": "\\b\\d+\\b"
        },
        "urls": {
            "name": "support.constant.url.snaptest",
            "match": "(https?|ftp|file)://[-A-Za-z0-9+&@#/%?=~_|!:,.;]*[-A-Za-z0-9+&@#/%=~_|]"
        }
    },
    "scopeName": "source.snaptest",
    "uuid": "c735ff89-1fc6-4701-9e29-6de20702a66d"
}
