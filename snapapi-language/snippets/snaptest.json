{
    "Suite skeleton": {
        "prefix": ["suite", "SUITE"],
        "body": [
            "SUITE: ${1:Suite name}",
            "DESC: ${2:Description}",
            "TIMEOUT: ${3:10}",
            "URL: ${4:https://api.example.com}",
            "HEADER Content-Type: application/json",
            "",
            "TEST: ${5:Example}",
            "  GET: ${6:/path}",
            "  EXPECT: status == ${7:200}",
            ""
        ],
        "description": "SnapAPI suite with a GET test"
    },
    "TEST with GET": {
        "prefix": ["test-get", "TEST"],
        "body": [
            "TEST: ${1:Get resource}",
            "TAG: ${2:smoke}",
            "  GET: ${3:/path}",
            "  EXPECT: status == ${4:200}",
            ""
        ],
        "description": "TEST block with GET"
    },
    "TEST with POST": {
        "prefix": ["test-post", "POST"],
        "body": [
            "TEST: ${1:Create resource}",
            "TAG: ${2:write}",
            "  POST: ${3:/path}",
            "  BODY: {",
            "    \"${4:name}\": \"${5:value}\"",
            "  }",
            "  EXPECT: status == ${6:201}",
            ""
        ],
        "description": "TEST block with POST and BODY"
    },
    "GET request": {
        "prefix": "GET",
        "body": "GET: ${1:/path}",
        "description": "GET request alias"
    },
    "HEAD request": {
        "prefix": "HEAD",
        "body": "HEAD: ${1:/path}",
        "description": "HEAD request alias"
    },
    "OPTIONS request": {
        "prefix": ["REQUEST-OPTIONS", "HTTP-OPTIONS"],
        "body": "REQUEST: OPTIONS ${1:/path}",
        "description": "HTTP OPTIONS via REQUEST (suite OPTIONS is JSON config)"
    },
    "POST request": {
        "prefix": "POST",
        "body": [
            "POST: ${1:/path}",
            "BODY: {",
            "  \"${2:name}\": \"${3:value}\"",
            "}",
            "EXPECT: status == ${4:201}"
        ],
        "description": "POST request with BODY"
    },
    "EXPECT status": {
        "prefix": ["expect-status", "EXPECT"],
        "body": "EXPECT: status == ${1:200}",
        "description": "EXPECT status check"
    },
    "EXPECT body contains": {
        "prefix": "expect-body",
        "body": "EXPECT: body contains ${1:text}",
        "description": "EXPECT body contains check"
    },
    "EXPECT json": {
        "prefix": "expect-json",
        "body": "EXPECT: json ${1:$.path} == ${2:\"value\"}",
        "description": "EXPECT JSONPath check"
    },
    "EXPECT header": {
        "prefix": "expect-header",
        "body": "EXPECT: header ${1:Content-Type} contains ${2:json}",
        "description": "EXPECT response header check"
    },
    "EXPECT retry": {
        "prefix": "expect-retry",
        "body": "EXPECT: status == ${1:200} RETRY ${2:5}",
        "description": "EXPECT status with RETRY"
    },
    "EXPECT AND/OR": {
        "prefix": ["expect-or", "expect-and"],
        "body": "EXPECT: status == ${1:400} OR status == ${2:401}",
        "description": "EXPECT combined with OR"
    },
    "SAVE": {
        "prefix": "SAVE",
        "body": "SAVE: ${1:name} FROM ${2:$.path}",
        "description": "SAVE a JSONPath value"
    },
    "AUTH bearer": {
        "prefix": "AUTH",
        "body": "AUTH: bearer ${1:\\${TOKEN\\}}",
        "description": "Bearer AUTH header"
    },
    "HEADER": {
        "prefix": "HEADER",
        "body": "HEADER ${1:Content-Type}: ${2:application/json}",
        "description": "Single HEADER line"
    },
    "QUERY": {
        "prefix": "QUERY",
        "body": "QUERY: ${1:page=1}&${2:limit=10}",
        "description": "Query string on the current request"
    },
    "PARAM": {
        "prefix": "PARAM",
        "body": "PARAM: ${1:name} ${2:value}",
        "description": "Single query PARAM"
    },
    "HELPER": {
        "prefix": ["helper", "HELPER"],
        "body": [
            "HELPER: ${1:Authenticate}",
            "  POST: ${2:/login}",
            "  BODY: {\"email\": \"${3:\\${EMAIL\\}}\", \"password\": \"${4:\\${PASSWORD\\}}\"}",
            "  EXPECT: status == ${5:200}",
            "  SAVE: ${6:accessToken} FROM ${7:$.data.accessToken}",
            ""
        ],
        "description": "Named helper for SUITE-SETUP / SETUP (not a test case)"
    },
    "DEPENDS": {
        "prefix": "DEPENDS",
        "body": "DEPENDS: ${1:Create User}",
        "description": "Run named tests first; skip this test if they failed or skipped"
    },
    "IMPORT": {
        "prefix": "IMPORT",
        "body": "IMPORT: ${1:other.sapi}",
        "description": "Import tests from another file"
    }
}
